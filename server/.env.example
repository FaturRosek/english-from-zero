# ================================================================
# English From Zero — Backend Environment Configuration
# ================================================================
# Copy this file to ".env" and fill in your values.
#   cp .env.example .env   (Linux/Mac)
#   copy .env.example .env (Windows)
#
# NEVER commit the .env file to version control.
# ================================================================

# Gemini API Key — Dapatkan gratis di https://aistudio.google.com
GEMINI_API_KEY=your_api_key_here

# Port untuk backend server (default: 3000)
PORT=3000

# Model Gemini yang digunakan oleh backend
GEMINI_MODEL=gemini-2.5-flash-preview

# CORS: Origins frontend yang diizinkan (pisahkan dengan koma)
# Gunakan "null" untuk mengizinkan akses dari file:// protocol
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,null

# Rate limiting: maksimum request per menit per IP
RATE_LIMIT_PER_MINUTE=20

# Validasi input: panjang maksimum pesan (karakter)
MAX_MESSAGE_LENGTH=2000

# Validasi input: jumlah maksimum pesan dalam satu request
MAX_MESSAGES=50
